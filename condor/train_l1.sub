project_dir = /nethome/jabhagiya/projects/hlcv-project-gans
data_dir = /data/users/jabhagiya/hlcv-project-gans
run = unet-l1-seed-7

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /nethome/jabhagiya
executable = $(project_dir)/condor/run.sh
arguments = -m src.train_l1 --manifest $(data_dir)/manifests/pairs.csv --data-root $(data_dir) --output $(data_dir)/runs/$(run) --device cuda --wandb-mode offline --wandb-project hlcv-sim2real
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/hlcv-project-gans REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/$(run).$(ClusterId).log

request_cpus = 4
request_memory = 16G
request_disk = 10G
request_gpus = 1
requirements = (UidDomain == "lsv.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 12000)

queue 1
