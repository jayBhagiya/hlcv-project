project_dir = $(PROJECT_DIR:.)
data_dir = $(DATA_DIR:.)
run = evaluation-seed-$(seed)-lpips-kid

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = -m src.evaluator --manifest $(data_dir)/manifests/pairs.csv --data-root $(data_dir) --output $(data_dir)/evaluations/$(run) --run unet-l1=$(data_dir)/runs/unet-l1-seed-$(seed)/best.pt --run transformer-l1=$(data_dir)/runs/transformer-l1-seed-$(seed)/best.pt --device cuda
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/hlcv-project-gans REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/$(run).$(ClusterId).log

request_cpus = 4
request_memory = 16G
request_disk = 10G
request_gpus = 1
requirements = (UidDomain == "lsv.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 12000)

queue seed in 21, 42
