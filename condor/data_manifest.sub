project_dir = /nethome/jabhagiya/projects/hlcv-project-gans
data_dir = /data/users/jabhagiya/hlcv-project-gans

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = /nethome/jabhagiya
executable = $(project_dir)/condor/run.sh
arguments = -m src.data_manifest --data-dir $(data_dir)/data --output $(data_dir)/manifests/pairs.csv
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/hlcv-project-gans"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/data-manifest.$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/data-manifest.$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/data-manifest.$(ClusterId).log

request_cpus = 1
request_memory = 2G
request_disk = 1G
request_gpus = 0

queue 1
