project_dir = $(PROJECT_DIR:.)
data_dir = $(DATA_DIR:.)
run = evaluation-seed-7-with-turbo

universe = docker
docker_image = pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime
initialdir = $(project_dir)
executable = $(project_dir)/condor/run.sh
arguments = -m src.evaluator --manifest $(data_dir)/manifests/pairs.csv --data-root $(data_dir) --output $(data_dir)/evaluations/$(run) --run unet-l1=$(data_dir)/runs/unet-l1-seed-7/best.pt --run pix2pix=$(data_dir)/runs/pix2pix-seed-7/best.pt --run transformer-l1=$(data_dir)/runs/transformer-l1-seed-7/best.pt --run cyclegan-turbo=$(data_dir)/runs/cyclegan-turbo-seed-7/last.pt --batch-size 1 --device cuda
environment = "PROJECT_DIR=$(project_dir) DATA_DIR=$(data_dir) VENV=$(data_dir)/venvs/hlcv-cycle-turbo REQUIRE_CUDA=1"
should_transfer_files = NO
getenv = HOME
+WantGPUHomeMounted = true

output = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).out
error = $(data_dir)/logs/$(run).$(ClusterId).$(ProcId).err
log = $(data_dir)/logs/$(run).$(ClusterId).log

request_cpus = 4
request_memory = 32G
request_disk = 30G
request_gpus = 1
requirements = (UidDomain == "lsv.uni-saarland.de") && (GPUs_GlobalMemoryMb >= 24000)

queue 1
